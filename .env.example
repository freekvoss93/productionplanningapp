# Kopieer deze namen naar de Environment Variables van je Vercel-project.
# Vul hier GEEN echte waarden in dit bestand in — dit bestand wordt wel
# meegecommit naar Git, alleen als documentatie van welke namen nodig zijn.

# Supabase Project Settings -> API -> Project URL
SUPABASE_URL=

# Supabase Project Settings -> API -> anon public key
SUPABASE_ANON_KEY=

# Supabase Project Settings -> API -> service_role key (GEHEIM, nooit delen)
SUPABASE_SERVICE_ROLE_KEY=
